# Copy to /opt/datxe/.env on the VPS and run: chmod 600 /opt/datxe/.env
POSTGRES_USER=datxe
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=datxe

JWT_SECRET=replace-with-at-least-32-random-bytes
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-web-client-id
CORS_ORIGINS=https://datxe.linuxunity.com

# Local VPS storage. Sensitive documents are served only through authenticated API routes.
UPLOAD_HOST_DIR=/opt/datxe/data/uploads
UPLOAD_DIR=/app/uploads
FILE_PUBLIC_BASE_URL=https://datxe.linuxunity.com

# Optional notification integration (AWS SES/SNS). Leave credentials empty to disable.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_SES_EMAIL_SENDER=noreply@datxe.linuxunity.com
SMS_PROVIDER=AWS_SNS
SMS_ENABLED=true
SMS_SENDER_ID=
SMS_ORIGINATION_NUMBER=
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
PUBLIC_APP_URL=https://datxe.linuxunity.com
ADMIN_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Payment gateways. Empty credentials mean the corresponding gateway is unavailable.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://datxe.linuxunity.com/payment
MOMO_IPN_URL=https://datxe.linuxunity.com/api/payments/momo-webhook
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

ENABLE_DEMO_DATA=false
ENABLE_PAYMENT_MOCKS=false
